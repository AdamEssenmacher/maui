<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net$(_MauiDotNetVersion)-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition=" '$(IncludeAndroidTargetFrameworks)' == 'true' ">$(TargetFrameworks);net$(_MauiDotNetVersion)-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>WebAuthenticatorCompletedOptionsRetentionLeakRepro</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>WebAuthenticatorCompletedOptionsRetentionLeakRepro</ApplicationTitle>
    <ApplicationId>com.microsoft.maui.webauthenticatorcompletedoptionsretentionleakrepro</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <Import Project="$(MauiSrcDirectory)Maui.InTree.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\src\Core.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Xaml\Controls.Xaml.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Core\Controls.Core.csproj" />
    <ProjectReference Include="..\..\..\Essentials\src\Essentials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcons\appicon.svg" ForegroundFile="Resources\AppIcons\appiconfg.svg" Color="#34495E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#34495E" BaseSize="128,128" />
  </ItemGroup>

</Project>
