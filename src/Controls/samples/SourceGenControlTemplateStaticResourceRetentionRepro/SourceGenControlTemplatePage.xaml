<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SourceGenControlTemplateStaticResourceRetentionRepro.SourceGenControlTemplatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ContentPage.Resources>
        <x:String x:Key="TemplateText">SourceGen ControlTemplate StaticResource content</x:String>
        <ControlTemplate x:Key="EscapedTemplate">
            <Grid Padding="4">
                <Label Text="{StaticResource TemplateText}" />
            </Grid>
        </ControlTemplate>
    </ContentPage.Resources>
</ContentPage>
