<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net$(_MauiDotNetVersion)-maccatalyst</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SwipeViewRendererContentLeakRepro</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416;CA1422;CS0612;CS0618;XC0022</NoWarn>
    <ApplicationTitle>SwipeViewRendererContentLeakRepro</ApplicationTitle>
    <ApplicationId>com.microsoft.maui.swipeviewrenderercontentleakrepro</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <Import Project="$(MauiSrcDirectory)Maui.InTree.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\src\Core.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Xaml\Controls.Xaml.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Core\Controls.Core.csproj" />
    <ProjectReference Include="..\..\..\Compatibility\Core\src\Compatibility.csproj" />
    <ProjectReference Include="..\..\..\Essentials\src\Essentials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcons\appicon.svg" ForegroundFile="Resources\AppIcons\appiconfg.svg" Color="#415A77" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#415A77" BaseSize="128,128" />
  </ItemGroup>

</Project>
